{
  "name": "portfolio-fullstack",
  "version": "1.0.0",
  "description": "Portfolio Website with Express Backend",
  "scripts": {
    "start": "node backend/server.js",
    "backend": "node backend/server.js",
    "frontend": "npx vite --host 0.0.0.0 --port 5173",
    "dev:frontend": "npx vite --host 0.0.0.0 --port 5173",
    "clear:ports": "node scripts/clear-ports.js",
    "dev": "node scripts/clear-ports.js && concurrently \"node backend/server.js\" \"npx vite --host 0.0.0.0 --port 5173\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
    "dev:all": "node scripts/clear-ports.js && concurrently \"node backend/server.js\" \"npx vite --host 0.0.0.0 --port 5173\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
    "db": "node backend/database/db.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0"
  }
}
